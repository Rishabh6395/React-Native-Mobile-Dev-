{
  "name": "hourly-workspace",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start -w mobile",
    "dev:api": "npm run dev -w api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@expo/cli": "^57.0.27",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~57.0.26",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
